#!/bin/sh
# 설치는 됐지만 로그인은 안 된 claude 를 흉내 낸다.
# ⚠️ --version 은 성공한다 — 이것이 화면이 거짓 초록불을 켰던 이유다.
case "$1" in
  --version) echo "2.1.223 (Claude Code)"; exit 0 ;;
esac
cat > /dev/null
echo '{"type":"result","is_error":true,"result":"Failed to authenticate: OAuth session expired and could not be refreshed"}'
exit 0
