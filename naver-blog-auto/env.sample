# 이 파일을 .env.local 로 복사해서 쓰세요.
#   맥/리눅스:  cp env.sample .env.local
#   윈도우:     copy env.sample .env.local
# 값을 넣은 뒤에는 앱을 껐다 켜야 반영됩니다.

# ── AI 사진 생성(선택) ──────────────────────────────
# 안 넣어도 앱은 전부 돌아갑니다. 사진을 "AI 생성"으로 만들 때만 필요합니다.
# https://dash.cloudflare.com → Workers AI 에서 만듭니다.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── claude 실행 파일 경로(보통 비워두세요) ──────────
# 윈도우에서 claude 를 못 찾는다고 나올 때만 전체 경로를 적습니다.
CLAUDE_BIN=

# ── 기본값 바꾸기(선택) ─────────────────────────────
# 앱 안 설정 화면에서 바꾸는 게 더 편합니다. 여기 값은 "맨 처음 기본값"으로만 쓰입니다.
# DRY_RUN=true
# VISIBILITY=private
# DAILY_PUBLISH_LIMIT=3
# MIN_PUBLISH_INTERVAL_MIN=30

# ── 브라우저 경로(보통 비워두세요) ──────────────────
# 앱이 브라우저를 자동으로 내려받지 못하는 환경에서만, 이미 깔린 크롬 경로를 적습니다.
CHROMIUM_PATH=
